; La otra mitad del acuerdo: .gitattributes manda en git, esto manda en el
; editor. Sin los dos, cada quien reintroduce su final de linea al guardar.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2
