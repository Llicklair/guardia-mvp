# Fronteras de importacion. Las comprueba `gb graph src --gate`.
# Sintaxis: SRC -/-> DST  ("ningun modulo bajo SRC puede importar uno bajo DST").
#
# La direccion que importa: los modulos de abajo (autoridad, registro) no pueden
# depender de los de arriba. Si `actores` acabara importando `politica`, la
# comprobacion de autoridad pasaria a depender de lo que se este proponiendo, que
# es exactamente lo que la regla 3 prohibe.

# El nucleo de autoridad no depende de nada del dominio.
guardia.actores -/-> guardia.politica
guardia.actores -/-> guardia.invariantes
guardia.actores -/-> guardia.kill_switch
guardia.actores -/-> guardia.cli

# El log no depende de lo que registra.
guardia.auditoria -/-> guardia.politica
guardia.auditoria -/-> guardia.invariantes
guardia.auditoria -/-> guardia.kill_switch
guardia.auditoria -/-> guardia.cli

# La gramatica no conoce ni invariantes ni interruptor: es solo forma.
guardia.politica -/-> guardia.invariantes
guardia.politica -/-> guardia.kill_switch
guardia.politica -/-> guardia.cli

# Los invariantes leen propuestas, pero no tocan el interruptor ni la CLI.
guardia.invariantes -/-> guardia.kill_switch
guardia.invariantes -/-> guardia.cli

# El interruptor no depende del dominio de politica: tiene que funcionar aunque
# todo lo demas este roto.
guardia.kill_switch -/-> guardia.politica
guardia.kill_switch -/-> guardia.invariantes
guardia.kill_switch -/-> guardia.cli
guardia.kill_switch -/-> guardia.crisol
guardia.kill_switch -/-> guardia.motor
guardia.kill_switch -/-> guardia.aplicador

# La telemetria es solo forma de dato: no conoce politica ni motor ni crisol.
guardia.eventos -/-> guardia.politica
guardia.eventos -/-> guardia.motor
guardia.eventos -/-> guardia.crisol
guardia.eventos -/-> guardia.cli

# El motor de replay lee propuestas y eventos, pero no orquesta nada por encima.
guardia.motor -/-> guardia.crisol
guardia.motor -/-> guardia.aplicador
guardia.motor -/-> guardia.kill_switch
guardia.motor -/-> guardia.cli

# El aplicador maneja estado; no depende del motor, el crisol ni la CLI.
guardia.aplicador -/-> guardia.motor
guardia.aplicador -/-> guardia.crisol
guardia.aplicador -/-> guardia.cli

# El crisol no depende del despliegue que la envuelve por encima.
guardia.crisol -/-> guardia.cli
guardia.crisol -/-> guardia.despliegue

# El despliegue es el techo del dominio (junto con la CLI): produce el ciclo completo
# incidente -> propuesta -> gates -> aplicacion, y nada por debajo lo importa.
guardia.despliegue -/-> guardia.cli

# T2 (triaje) solo lee y propone: conoce politica, eventos y auditoria, y NADA de T3.
# Que no pueda importar crisol/despliegue/aplicador es la regla 3 en el grafo: el nivel
# que genera propuestas no puede alcanzar el que las aplica.
guardia.triaje -/-> guardia.crisol
guardia.triaje -/-> guardia.despliegue
guardia.triaje -/-> guardia.motor
guardia.triaje -/-> guardia.aplicador
guardia.triaje -/-> guardia.invariantes
guardia.triaje -/-> guardia.kill_switch
guardia.triaje -/-> guardia.cli

# Los cimientos no conocen el triaje.
guardia.actores -/-> guardia.triaje
guardia.auditoria -/-> guardia.triaje
guardia.politica -/-> guardia.triaje
guardia.eventos -/-> guardia.triaje

# Los cimientos siguen sin conocer el despliegue.
guardia.actores -/-> guardia.despliegue
guardia.auditoria -/-> guardia.despliegue
guardia.politica -/-> guardia.despliegue
guardia.invariantes -/-> guardia.despliegue
guardia.eventos -/-> guardia.despliegue
guardia.motor -/-> guardia.despliegue
guardia.aplicador -/-> guardia.despliegue
guardia.kill_switch -/-> guardia.despliegue

# El transporte es un canal tonto: no conoce ni el dominio ni a quien le habla. Que
# no importe politica ni triaje es lo que permite que T2 y el evaluador lo compartan
# sin conocerse entre ellos.
guardia.transporte -/-> guardia.politica
guardia.transporte -/-> guardia.triaje
guardia.transporte -/-> guardia.evaluador
guardia.transporte -/-> guardia.eventos
guardia.transporte -/-> guardia.auditoria
guardia.transporte -/-> guardia.cli

# El guardia de JSON hostil es una hoja pura: cinco consumidores que no se conocen
# entre si (politica, eventos, triaje, evaluador, generador, auditoria) lo comparten
# precisamente porque el no conoce a ninguno. Si importara dominio, dejaria de poder
# vivir debajo de todos.
guardia.json_hostil -/-> guardia.politica
guardia.json_hostil -/-> guardia.eventos
guardia.json_hostil -/-> guardia.triaje
guardia.json_hostil -/-> guardia.evaluador
guardia.json_hostil -/-> guardia.generador
guardia.json_hostil -/-> guardia.auditoria
guardia.json_hostil -/-> guardia.transporte
guardia.json_hostil -/-> guardia.actores
guardia.json_hostil -/-> guardia.kill_switch
guardia.json_hostil -/-> guardia.invariantes
guardia.json_hostil -/-> guardia.crisol
guardia.json_hostil -/-> guardia.motor
guardia.json_hostil -/-> guardia.aplicador
guardia.json_hostil -/-> guardia.despliegue
guardia.json_hostil -/-> guardia.banco
guardia.json_hostil -/-> guardia.banco_evaluador
guardia.json_hostil -/-> guardia.nftables
guardia.json_hostil -/-> guardia.informe
guardia.json_hostil -/-> guardia.cli

# El evaluador adversarial (regla 10, ADR 0007) es ADVISORY: mira una propuesta y
# emite objeciones. Que no pueda importar crisol/despliegue/aplicador es lo que hace
# imposible por construccion que su dictamen se convierta en un veredicto.
guardia.evaluador -/-> guardia.crisol
guardia.evaluador -/-> guardia.despliegue
guardia.evaluador -/-> guardia.aplicador
guardia.evaluador -/-> guardia.motor
guardia.evaluador -/-> guardia.invariantes
guardia.evaluador -/-> guardia.kill_switch
guardia.evaluador -/-> guardia.cli

# Y proponente != evaluador tambien en el grafo: no se conocen. Comparten transporte,
# no rol; si un dia el triaje pudiera invocar a su propio juez, la separacion seria
# nominal. (Decia "generador" cuando no existia un modulo con ese nombre; aqui el que
# genera propuestas es el triaje.)
guardia.triaje -/-> guardia.evaluador
guardia.evaluador -/-> guardia.triaje

# El banco (metrica 5) es instrumentacion: observa el ciclo desde fuera y NADA del
# sistema lo importa. Si un modulo del producto necesitara el banco para funcionar,
# la medicion habria pasado a formar parte de lo medido.
guardia.actores -/-> guardia.banco
guardia.auditoria -/-> guardia.banco
guardia.politica -/-> guardia.banco
guardia.invariantes -/-> guardia.banco
guardia.eventos -/-> guardia.banco
guardia.motor -/-> guardia.banco
guardia.aplicador -/-> guardia.banco
guardia.kill_switch -/-> guardia.banco
guardia.crisol -/-> guardia.banco
guardia.despliegue -/-> guardia.banco
guardia.triaje -/-> guardia.banco
# (la CLI si lo importa: es quien lo expone al humano, como con el despliegue)

# Y el banco no toca la maquinaria por dentro: mide el ciclo por su superficie
# publica (T2 propone, T3 despliega). Si necesitara el aplicador o el motor, estaria
# midiendo las tripas en vez del comportamiento.
guardia.banco -/-> guardia.aplicador
guardia.banco -/-> guardia.motor
guardia.banco -/-> guardia.crisol
guardia.banco -/-> guardia.invariantes
guardia.banco -/-> guardia.cli

# El banco del evaluador (ADR 0007) mide la senal advisory: instrumentacion, igual que
# el banco de la metrica 5. Nada del sistema lo importa salvo la CLI, que lo expone.
guardia.actores -/-> guardia.banco_evaluador
guardia.auditoria -/-> guardia.banco_evaluador
guardia.politica -/-> guardia.banco_evaluador
guardia.invariantes -/-> guardia.banco_evaluador
guardia.eventos -/-> guardia.banco_evaluador
guardia.motor -/-> guardia.banco_evaluador
guardia.aplicador -/-> guardia.banco_evaluador
guardia.kill_switch -/-> guardia.banco_evaluador
guardia.crisol -/-> guardia.banco_evaluador
guardia.despliegue -/-> guardia.banco_evaluador
guardia.triaje -/-> guardia.banco_evaluador
guardia.evaluador -/-> guardia.banco_evaluador
guardia.transporte -/-> guardia.banco_evaluador
guardia.banco -/-> guardia.banco_evaluador

# Mide una senal advisory sobre propuestas que el mismo declara: no alcanza ni la
# maquinaria de aplicacion (seria confundir medir con aplicar) ni la telemetria (el
# evaluador no ve el corpus, y su banco tampoco — esa es justo la ventaja que mide).
guardia.banco_evaluador -/-> guardia.crisol
guardia.banco_evaluador -/-> guardia.despliegue
guardia.banco_evaluador -/-> guardia.aplicador
guardia.banco_evaluador -/-> guardia.motor
guardia.banco_evaluador -/-> guardia.invariantes
guardia.banco_evaluador -/-> guardia.kill_switch
guardia.banco_evaluador -/-> guardia.triaje
guardia.banco_evaluador -/-> guardia.eventos
guardia.banco_evaluador -/-> guardia.cli

# LA CEGUERA DEL GENERADOR, que es lo unico que hace valioso su corpus.
#
# El generador encarga inyecciones a un modelo que no ha visto el sistema. Si pudiera
# importar la gramatica, los invariantes o los gates, esa ceguera dependeria de que yo
# me acuerde de no escribirlos en el prompt — y entonces el corpus generado volveria a
# ser el mio, con un paso intermedio. Estas lineas la convierten en un hecho del grafo:
# no puede filtrar lo que no tiene delante. Solo alcanza `eventos` (el formato de cable,
# que el atacante ve porque es la telemetria que el mismo produce) y `transporte`.
guardia.generador -/-> guardia.politica
guardia.generador -/-> guardia.invariantes
guardia.generador -/-> guardia.crisol
guardia.generador -/-> guardia.motor
guardia.generador -/-> guardia.aplicador
guardia.generador -/-> guardia.despliegue
guardia.generador -/-> guardia.triaje
guardia.generador -/-> guardia.evaluador
guardia.generador -/-> guardia.kill_switch
guardia.generador -/-> guardia.actores
guardia.generador -/-> guardia.auditoria
guardia.generador -/-> guardia.cli

# Y tampoco ve el banco: ahi viven los predicados que deciden si una inyeccion acerto.
# Un generador que pudiera leer su propio criterio de exito estaria escribiendo el
# examen y corrigiendolo. El anclaje entre ENCARGOS y OBJETIVOS lo comprueba un test,
# que es el sitio donde debe vivir — fuera de los dos.
guardia.generador -/-> guardia.banco
guardia.generador -/-> guardia.banco_evaluador

# Instrumentacion, como los dos bancos: nada del sistema lo importa salvo la CLI.
guardia.actores -/-> guardia.generador
guardia.auditoria -/-> guardia.generador
guardia.politica -/-> guardia.generador
guardia.invariantes -/-> guardia.generador
guardia.eventos -/-> guardia.generador
guardia.motor -/-> guardia.generador
guardia.aplicador -/-> guardia.generador
guardia.kill_switch -/-> guardia.generador
guardia.crisol -/-> guardia.generador
guardia.despliegue -/-> guardia.generador
guardia.triaje -/-> guardia.generador
guardia.evaluador -/-> guardia.generador
guardia.transporte -/-> guardia.generador
guardia.banco -/-> guardia.generador
guardia.banco_evaluador -/-> guardia.generador

