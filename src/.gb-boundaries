guardia.informe -/-> guardia.eventos
guardia.informe -/-> guardia.banco
guardia.informe -/-> guardia.banco_evaluador
guardia.informe -/-> guardia.transporte
guardia.informe -/-> guardia.cli

guardia.actores -/-> guardia.informe
guardia.auditoria -/-> guardia.informe
guardia.politica -/-> guardia.informe
guardia.invariantes -/-> guardia.informe
guardia.eventos -/-> guardia.informe
guardia.motor -/-> guardia.informe
guardia.aplicador -/-> guardia.informe
guardia.kill_switch -/-> guardia.informe
guardia.crisol -/-> guardia.informe
guardia.despliegue -/-> guardia.informe
